<UserControl x:Class="MultiBoardViewer.Controls.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MultiBoardViewer.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver" DragLeave="UserControl_DragLeave">
    <Grid Background="#FAFAFA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="150"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN -->
        <Border Grid.Column="0" 
                BorderBrush="#DCDCDC" 
                BorderThickness="0,0,1,0" 
                Padding="20"
                Background="#FAFAFA"
                AllowDrop="True" DragEnter="BlockDrag" DragOver="BlockDrag" Drop="BlockDrop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search -->
                    <RowDefinition Height="*"/>    <!-- Recent Files / Search Results -->
                    <RowDefinition Height="Auto"/> <!-- About -->
                </Grid.RowDefinitions>

                <!-- Search Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="🔍 Search files" FontSize="16" FontWeight="SemiBold" Foreground="#323232" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox" FontSize="13" Padding="8,6,28,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Type to search..." FontSize="13" Foreground="#A0A0A0" 
                                       IsHitTestVisible="False" Padding="10,7,0,0" Visibility="Visible"/>
                            <Button x:Name="ClearSearchButton" Content="✕" FontSize="10" Width="18" Height="18" Padding="0" 
                                    Background="Transparent" BorderThickness="0" Foreground="#969696"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                    Visibility="Collapsed" Click="ClearSearchButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FF5050"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        
                        <Button x:Name="FolderButton" Grid.Column="1" Content="📁" FontSize="14" Width="36" Margin="5,0,0,0" 
                                Click="FolderButton_Click" ToolTip="Select search folder"/>
                    </Grid>
                </StackPanel>

                <!-- Results / Directory Tree -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <!-- Search Results -->
                    <ScrollViewer x:Name="SearchResultsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SearchResultsPanel"/>
                    </ScrollViewer>

                    <!-- Directory Tree -->
                    <Grid x:Name="DirectoryTreePanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title / Refresh button -->
                            <RowDefinition Height="*"/>    <!-- Tree View & Placeholder -->
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="📁 Directory tree" FontSize="16" FontWeight="SemiBold" Foreground="#323232" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshTreeButton" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    FontSize="11" Padding="8,2,8,2" Background="Transparent" BorderBrush="#DCDCDC" Foreground="#646464"
                                    Click="RefreshTreeButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#0078D4"/>
                                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        
                        <Grid Grid.Row="1">
                            <TreeView x:Name="FolderTreeView" BorderThickness="0" Background="Transparent"/>
                            <TextBlock x:Name="TreePlaceholder" Text="Please select a search folder first" FontSize="13" Foreground="#969696"
                                       FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="20"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#DCDCDC"
                      ShowsPreview="False"/>

        <!-- RIGHT COLUMN -->
        <Grid Grid.Column="2" Margin="20,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/> <!-- Recent files -->
                <RowDefinition Height="Auto"/> <!-- Gap / Divider if needed -->
                <RowDefinition Height="3*"/> <!-- DropZone / Open file -->
            </Grid.RowDefinitions>

            <!-- Recent Files Section -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="📋 Recent files" FontSize="16" FontWeight="SemiBold" Foreground="#323232"/>
                    <Button x:Name="ClearRecentButton" Content="Clear" HorizontalAlignment="Right" VerticalAlignment="Center"
                            FontSize="11" Padding="8,2,8,2" Background="Transparent" BorderBrush="#DCDCDC" Foreground="#646464"
                            Click="ClearRecentButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FF5050"/>
                                        <Setter Property="BorderBrush" Value="#FF5050"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RecentFilesList"/>
                </ScrollViewer>
            </Grid>

            <!-- Drop Zone Block -->
            <Border x:Name="DropZone" Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="20"
                    AllowDrop="True">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop file here" FontSize="16" Foreground="#646464" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="or" FontSize="11" Foreground="#969696" HorizontalAlignment="Center" Margin="0,5,0,5"/>
                    <Button x:Name="OpenFileButton" Content="➕ Open file" FontSize="12" Padding="15,6,15,6" 
                            Background="#0078D4" Foreground="White" BorderThickness="0" HorizontalAlignment="Center"
                            Click="OpenFileButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
